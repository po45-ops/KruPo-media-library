{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krupo-media-marketplace",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "staging",
    "ALLOW_STAGING_DEMO_DATA": "true",
    "NEXT_PUBLIC_APP_NAME": "KruPo คลังสื่อ",
    "NEXT_PUBLIC_APP_URL": "https://krupo-media-marketplace.krupo-media-marketplace.workers.dev",
    "PAYMENT_PROVIDER": "disabled",
    "STORAGE_PROVIDER": "local_test",
    "RATE_LIMIT_PROVIDER": "cloudflare",
    "COPYRIGHT_AI_PROVIDER": "BASIC"
  },
  "ratelimits": [
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_MUTATION", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_ACCESS", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["0 17 * * *"] }
}
